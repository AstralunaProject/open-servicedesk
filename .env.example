# Copie para ".env" e ajuste conforme necessário.
# Todas as variáveis são opcionais.

# Endereço e porta em que o sistema vai escutar
HOST=0.0.0.0
PORT=8080

# URL pela qual os usuários acessam o sistema (usada nos links dos e-mails)
BASE_URL=http://localhost:8080

# Pasta onde ficam banco de dados, anexos e chave secreta
# CHAMADOS_DATA_DIR=./data

# Chave secreta das sessões. Se vazia, é gerada automaticamente em DATA_DIR/secret_key
# SECRET_KEY=

# Banco de dados (padrão: SQLite dentro de DATA_DIR). Exemplo PostgreSQL:
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost/chamados

# Tamanho máximo de upload (MB)
MAX_UPLOAD_MB=20

# Defina 1 se o sistema estiver atrás de um proxy reverso (nginx, IIS, Caddy...)
PROXY_FIX=0

# Defina 1 se o acesso for exclusivamente via HTTPS
SESSION_COOKIE_SECURE=0

# Número de threads do servidor web
THREADS=8
